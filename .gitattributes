* text=auto

# Code and doc text: LF line endings
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows scripts: CRLF line endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Images, archives, icons: binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# Frozen K13 manifest: byte-exact (its sha256 is frozen), no line-ending conversion
iface/frozen_manifest/K13_MANIFEST.md -text
iface/frozen_k04/K04_INTERFACE_STUB.py -text
iface/frozen_k04/K04_INTERFACE_STUB_v2_MAP13.py -text
