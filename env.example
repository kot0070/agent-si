# K10A2 env.example: every environment setting the product app reads.
# Copy to app-config.json or export directly. No secret values here:
# SecretRef handles only (test-only refs), never raw keys.
# Backend/frontend locked versions live in backend.lock / frontend.lock.
# Machine-local overrides (e.g. an absolute npm cache dir) belong in the
# environment or app-config.json, never committed here.
AGENT_SI_DATA_DIR=./data
AGENT_SI_PORT=8770
AGENT_SI_NPM_CACHE=./.npm-cache
AGENT_SI_UI_SESSION_TOKEN=test-only-no-key
AGENT_SI_SESSION_STORE=memory
AGENT_SI_SESSION_ROOTS=./sessions
AGENT_SI_PROJECT_ID=demo-project
AGENT_SI_TASK_ID=demo-task
AGENT_SI_RUN_ID=demo-run
AGENT_SI_RUN_TEMP=./tmp/agent_si_run
AGENT_SI_BENCH_RUN_ID=bench-demo
AGENT_SI_TEST_RUN_ID=test-demo
AGENT_SI_BENCH_JOURNAL=./tmp/bench_journal.jsonl
AGENT_SI_PROBE_ENDPOINT=http://127.0.0.1:8001
AGENT_SI_PROBE_TIMEOUT_S=5
AGENT_SI_PROVIDER_SET=
AGENT_SI_SECRET_STORE=memory
AGENT_SI_PROFILE_DIR=./tmp/agent_si_profile
AGENT_SI_SECRET_REF=test-only-no-key
BACKEND_REF=backend==0.1.0
FRONTEND_REF=frontend==0.1.0
